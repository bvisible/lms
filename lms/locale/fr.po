msgid "Connected to « {0} » — channel {1}, account {2}, {3} media in the space."
msgstr "Connecté à « {0} » — canal {1}, compte {2}, {3} média(s) dans l'espace."

#: lms/lms/neoffice_commerce.py
msgid "Infomaniak account number"
msgstr "Numéro de compte Infomaniak"

#: lms/public/js/neoffice_lms_settings.js
